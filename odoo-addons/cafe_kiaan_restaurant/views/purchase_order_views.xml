<odoo>
    <record id="view_purchase_order_cafe_kiaan_form" model="ir.ui.view">
        <field name="name">purchase.order.form.cafe.kiaan</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_planned']" position="after">
                <field name="cafe_purchase"/>
                <field name="cafe_department" invisible="not cafe_purchase"/>
            </xpath>
        </field>
    </record>
    <record id="action_cafe_restaurant_purchases" model="ir.actions.act_window">
        <field name="name">Restaurant Purchases</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cafe_purchase','=',True)]</field>
        <field name="context">{'default_cafe_purchase': True}</field>
    </record>
    <menuitem id="menu_cafe_restaurant_purchases" name="Restaurant Purchases" parent="menu_cafe_kiaan_root" action="action_cafe_restaurant_purchases" sequence="90"/>
</odoo>
