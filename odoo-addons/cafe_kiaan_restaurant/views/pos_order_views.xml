<odoo>
    <record id="view_pos_order_cafe_kiaan_form" model="ir.ui.view">
        <field name="name">pos.order.form.cafe.kiaan</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="cafe_table"/>
                <field name="cafe_order_type"/>
                <field name="cafe_kitchen_status"/>
            </xpath>
        </field>
    </record>
</odoo>
